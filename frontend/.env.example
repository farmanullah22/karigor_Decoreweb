# ============================================================
# Decora - Frontend Environment Configuration
# Copy this file to `.env` when you need to override defaults.
# Local development works without a .env file at all.
# ============================================================

# Base URL of the REST API used by the axios client (src/services/api.js).
#
# Development (default):
#   Leave this unset or set it to /api. Vite proxies /api and /uploads
#   to http://localhost:5000 (see vite.config.js).
#
# Production:
#   Point it at the deployed API, including the /api suffix, e.g.
#   VITE_API_URL=https://api.yourdomain.com/api
#   The origin (https://api.yourdomain.com) is then used to resolve
#   relative /uploads/... image URLs returned by the API.
#
# Tip: if frontend and API are served from the SAME domain (e.g. behind
# one Nginx server), you can keep the default /api and skip this file.
VITE_API_URL=/api
