# ============================================================
# Karigor Decore - Backend Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to version control.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/karigor-decore
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/karigor-decore
MONGODB_URI=mongodb://127.0.0.1:27017/karigor-decore

# JWT - generate a long random secret for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins for CORS
# Include every origin the site is served from (e.g. extra local ports).
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Max upload size in megabytes
UPLOAD_MAX_MB=5

# -------- Seed / first admin (development only) --------
# Used by `npm run seed` to create the first admin account.
# CHANGE THESE before seeding a production database.
SEED_ADMIN_NAME=Karigor Admin
SEED_ADMIN_EMAIL=admin@karigordecore.com
SEED_ADMIN_PASSWORD=Karigor@Admin2026
